<?xml version="1.0" encoding="utf-8"?>
<!-- Window background for AppCompat dialogs: rounded and inset, matching
     the Material dialogs so a list-preference picker looks like the rest. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp" android:insetRight="20dp"
    android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <corners android:radius="28dp" />
        <solid android:color="@color/m3_surface_container_high" />
    </shape>
</inset>
