<?xml version="1.0" encoding="utf-8"?>
<!-- The standard surface: a translucent sheen with a hairline edge. The
     diagonal gradient is what makes it read as glass rather than flat fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/r_lg" />
    <gradient
        android:type="linear"
        android:angle="300"
        android:startColor="#1CFFFFFF"
        android:centerColor="#0EFFFFFF"
        android:endColor="#07FFFFFF" />
    <stroke android:width="@dimen/hairline" android:color="@color/glass_stroke" />
</shape>
