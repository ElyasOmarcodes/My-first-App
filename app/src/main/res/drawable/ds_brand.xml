<?xml version="1.0" encoding="utf-8"?>
<!-- The brand sweep: indigo → violet → cyan. Header and primary button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/r_lg" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/brand_1"
        android:centerColor="@color/brand_2"
        android:endColor="@color/brand_3" />
</shape>
