<?xml version="1.0" encoding="utf-8"?>
<!-- First-run introduction: four soft pages (welcome, app language,
     what the keyboard does, turning it on) with dots and a next button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/intro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_profile">

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-120dp"
        android:layout_marginEnd="-140dp"
        android:alpha="0.7"
        android:background="@drawable/bg_avatar_glow" />

    <LinearLayout
        android:id="@+id/intro_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- skip -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/intro_skip"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:text="@string/intro_skip" />

        <FrameLayout
            android:id="@+id/page_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 1 · welcome -->
            <LinearLayout
                android:id="@+id/page_welcome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">
                <FrameLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_glow" />
                    <ImageView
                        android:id="@+id/intro_logo"
                        android:layout_width="128dp"
                        android:layout_height="128dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo_app"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Hk.PageTitle" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/intro_welcome_sub"
                    android:textAppearance="@style/TextAppearance.Hk.Body"
                    android:textSize="15.5sp" />
                <LinearLayout
                    android:id="@+id/intro_langs_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- 2 · app language -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/page_lang"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp">
                    <FrameLayout
                        android:id="@+id/welcome_icon_box"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_tone">
                        <ImageView
                            android:id="@+id/welcome_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_m_translate"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/app_lang_title"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.Hk.PageTitle"
                        android:textSize="27sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/welcome_sub"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.Hk.Body" />
                    <LinearLayout
                        android:id="@+id/intro_lang_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- 3 · features -->
            <LinearLayout
                android:id="@+id/page_features"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/intro_features_title"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Hk.PageTitle"
                    android:textSize="27sp" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Hk.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">
                    <LinearLayout
                        android:id="@+id/intro_features"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 4 · turn it on -->
            <LinearLayout
                android:id="@+id/page_setup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_hero"
                    android:padding="14dp"
                    android:src="@drawable/illus_keyboard"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center"
                    android:text="@string/intro_setup_title"
                    android:textAppearance="@style/TextAppearance.Hk.PageTitle"
                    android:textSize="27sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/intro_setup_sub"
                    android:textAppearance="@style/TextAppearance.Hk.Body" />
                <include
                    android:id="@+id/setup_enable"
                    layout="@layout/item_setup_step" />
                <include
                    android:id="@+id/setup_select"
                    layout="@layout/item_setup_step" />
            </LinearLayout>
        </FrameLayout>

        <!-- dots + next -->
        <LinearLayout
            android:id="@+id/intro_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">
            <LinearLayout
                android:id="@+id/intro_dots"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/intro_next"
                style="@style/Widget.Hk.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:text="@string/intro_next"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_m_next"
                app:iconGravity="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
