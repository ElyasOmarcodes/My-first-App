<?xml version="1.0" encoding="utf-8"?>
<!--
  Slider row. The ids `seekbar` and `seekbar_value` are the ones
  androidx.preference.SeekBarPreference looks up, so they must keep these
  exact names; resource merging maps them onto the library's own ids.
  The value sits in a chip above the slider rather than squeezed beside it,
  which leaves the slider its full width.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/ds_row"
    android:paddingStart="@dimen/sp_4"
    android:paddingEnd="@dimen/sp_4"
    android:paddingTop="@dimen/sp_3"
    android:paddingBottom="@dimen/sp_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/icon_frame"
            android:layout_width="@dimen/badge"
            android:layout_height="@dimen/badge"
            android:layout_marginEnd="@dimen/sp_3"
            android:background="@drawable/ds_badge">

            <ImageView
                android:id="@android:id/icon"
                android:layout_width="@dimen/badge_icon"
                android:layout_height="@dimen/badge_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@android:id/title"
                style="@style/T.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@android:id/summary"
                style="@style/T.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/seekbar_value"
            style="@style/T.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:gravity="center"
            android:paddingStart="@dimen/sp_2"
            android:paddingEnd="@dimen/sp_2"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/ds_chip"
            android:textColor="@color/brand_3" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_1"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:splitTrack="false" />

</LinearLayout>
