<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="120dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings"
            android:textAppearance="@style/TextAppearance.Hk.PageTitle" />

        <!-- ================================================ app language -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hk.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <include
                    android:id="@+id/head_lang"
                    layout="@layout/item_card_head" />
                <LinearLayout
                    android:id="@+id/lang_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================ appearance -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hk.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <include
                    android:id="@+id/head_look"
                    layout="@layout/item_card_head" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/look_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/look_light"
                        style="@style/Widget.Hk.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/look_light"
                        app:icon="@drawable/ic_m_light" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/look_auto"
                        style="@style/Widget.Hk.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/look_auto"
                        app:icon="@drawable/ic_m_auto" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/look_dark"
                        style="@style/Widget.Hk.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/look_dark"
                        app:icon="@drawable/ic_m_dark" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- keyboard sections are added here in code -->
        <LinearLayout
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
