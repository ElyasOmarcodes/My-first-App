<?xml version="1.0" encoding="utf-8"?>
<!-- Section label above a group card. The tag lets PrefGroupCards tell a
     heading from a row when it draws the cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:tag="pref_category"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="22dp"
    android:paddingBottom="10dp">
    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Hk.Section" />
    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Hk.Caption"
        android:visibility="gone" />
</LinearLayout>
