<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="120dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_about"
            android:textAppearance="@style/TextAppearance.Hk.PageTitle" />

        <!-- ============================================== identity -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hk.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">
                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@mipmap/ic_launcher"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Hk.PageTitle"
                    android:textSize="24sp" />
                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_tone"
                    android:backgroundTint="?attr/colorSecondaryContainer"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/about_publisher"
                    android:textColor="@color/tone_amber_fg"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/about_desc"
                    android:textAppearance="@style/TextAppearance.Hk.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================== sites -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/about_sites"
            android:textAppearance="@style/TextAppearance.Hk.Section" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hk.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:id="@+id/sites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================== contact -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/contact_manager"
            android:textAppearance="@style/TextAppearance.Hk.Section" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hk.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:id="@+id/person_box"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_tone">
                        <ImageView
                            android:id="@+id/person_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_m_person"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_manager_name"
                            android:textAppearance="@style/TextAppearance.Hk.RowTitle"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/contact_whatsapp_num"
                            android:textAppearance="@style/TextAppearance.Hk.Body"
                            android:textDirection="ltr" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_whatsapp"
                    style="@style/Widget.Hk.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/contact_whatsapp_btn"
                    android:textColor="@color/on_success"
                    app:backgroundTint="@color/success"
                    app:icon="@drawable/ic_m_chat"
                    app:iconGravity="textStart"
                    app:iconTint="@color/on_success" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================== privacy -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hk.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <include
                android:id="@+id/row_privacy"
                layout="@layout/item_nav_row" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/about_copyright"
            android:textAppearance="@style/TextAppearance.Hk.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
