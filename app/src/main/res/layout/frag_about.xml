<?xml version="1.0" encoding="utf-8"?>
<!-- About tab: the developer's profile (photo, name, title, bio, what he
     builds and teaches, how to reach him), then the app itself. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ============================================== profile header -->
        <LinearLayout
            android:id="@+id/profile_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="28dp"
            android:paddingBottom="22dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/avatar_wrap"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:clipChildren="false">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_glow" />
                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center">
                    <View
                        android:id="@+id/avatar_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_elyas"
                        android:padding="3dp"
                        app:strokeColor="@color/m3_background"
                        app:strokeWidth="6dp"
                        app:shapeAppearanceOverlay="@style/Shape.Hk.Circle"
                        android:contentDescription="@string/dev_name" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/dev_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-14dp"
                android:text="@string/dev_name"
                android:textAppearance="@style/TextAppearance.Hk.PageTitle"
                android:textSize="24sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.04"
                android:text="@string/dev_name_latin"
                android:textAppearance="@style/TextAppearance.Hk.Caption"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/dev_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingTop="9dp"
                android:paddingEnd="18dp"
                android:paddingBottom="9dp"
                android:text="@string/dev_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- bio -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bio_card"
                style="@style/Widget.Hk.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="7dp"
                    android:padding="22dp"
                    android:text="@string/dev_bio"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- builds for -->
            <include
                android:id="@+id/sec_builds"
                layout="@layout/item_section_head" />
            <LinearLayout
                android:id="@+id/platforms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false" />

            <!-- teaches -->
            <include
                android:id="@+id/sec_teach"
                layout="@layout/item_section_head" />
            <FrameLayout
                android:id="@+id/teacher_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tile_amber"
                android:elevation="6dp"
                android:minHeight="150dp"
                android:clipChildren="true">
                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="-18dp"
                    android:layout_marginBottom="-30dp"
                    android:alpha="0.16"
                    android:src="@drawable/ic_m_school"
                    app:tint="@android:color/white"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:padding="22dp">
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_tone"
                        android:backgroundTint="#33FFFFFF">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_m_menu_book"
                            app:tint="@android:color/white"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/dev_teacher"
                        android:textColor="@android:color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.92"
                        android:text="@string/dev_teacher_sub"
                        android:textColor="@android:color/white"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- contact -->
            <include
                android:id="@+id/sec_contact"
                layout="@layout/item_section_head" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/dev_contact_hint"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.Hk.Caption" />
            <LinearLayout
                android:id="@+id/contacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- the app -->
            <include
                android:id="@+id/sec_app"
                layout="@layout/item_section_head" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hk.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">
                        <ImageView
                            android:id="@+id/app_logo"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/logo_app"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/app_name"
                                android:textAlignment="viewStart"
                                android:textAppearance="@style/TextAppearance.Hk.CardTitle" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="8dp"
                        android:text="@string/about_desc"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.Hk.Body" />
                    <include
                        android:id="@+id/row_privacy"
                        layout="@layout/item_nav_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Hk.Caption" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/about_copyright"
                android:textAppearance="@style/TextAppearance.Hk.Caption"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
