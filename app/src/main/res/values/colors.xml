<?xml version="1.0" encoding="utf-8"?>
<!--
  Hindukush Keyboard — design tokens (dark is the default surface).
  Screens never hard-code a hex value; they reference these names, so the
  whole app re-themes from one file and a light variant stays possible.
-->
<resources>

    <!-- ============ legacy names kept: manifest + themes reference them -->
    <color name="primary">#0E1320</color>
    <color name="primary_dark">#070A12</color>
    <color name="accent">#6C7BFF</color>
    <color name="launcher_bg">#242A38</color>
    <color name="splash_bg">#070A12</color>

    <!-- ============ surfaces, darkest to lightest -->
    <color name="bg">#070A12</color>
    <color name="bg_raised">#0D1220</color>
    <color name="surface">#141B2D</color>
    <color name="surface_high">#1B2439</color>
    <color name="surface_press">#222D47</color>

    <!-- translucent glass fills, layered over the gradient background -->
    <color name="glass_fill">#14FFFFFF</color>
    <color name="glass_fill_soft">#0AFFFFFF</color>
    <color name="glass_stroke">#1FFFFFFF</color>
    <color name="glass_stroke_soft">#14FFFFFF</color>
    <color name="scrim">#A6000000</color>

    <!-- ============ text -->
    <color name="text_primary">#F3F6FF</color>
    <color name="text_secondary">#A3B0D0</color>
    <color name="text_tertiary">#6E7B9C</color>
    <color name="text_on_accent">#FFFFFF</color>

    <!-- ============ brand gradient (header, primary button, splash) -->
    <color name="brand_1">#6C7BFF</color>
    <color name="brand_2">#A972FF</color>
    <color name="brand_3">#33D6E8</color>

    <!-- ============ the colourful accents: one per settings category -->
    <color name="c_indigo">#6C7BFF</color>
    <color name="c_violet">#A972FF</color>
    <color name="c_cyan">#33D6E8</color>
    <color name="c_teal">#2DD4A7</color>
    <color name="c_mint">#34D399</color>
    <color name="c_lime">#9BE564</color>
    <color name="c_amber">#FFB03A</color>
    <color name="c_orange">#FF8A4C</color>
    <color name="c_rose">#FF6B8A</color>
    <color name="c_pink">#FF5CA8</color>
    <color name="c_sky">#38BDF8</color>
    <color name="c_blue">#4FA3FF</color>

    <!-- ============ states -->
    <color name="ok">#34D399</color>
    <color name="warn">#FFB03A</color>
    <color name="danger">#FF6B6B</color>
    <color name="ripple">#26FFFFFF</color>
    <color name="divider">#16FFFFFF</color>

</resources>
