<?xml version="1.0" encoding="utf-8"?>
<!-- One spacing and radius scale for the whole app. Screens use these
     instead of inventing numbers, which is what keeps the rhythm even. -->
<resources>

    <!-- spacing: a 4dp grid -->
    <dimen name="sp_1">4dp</dimen>
    <dimen name="sp_2">8dp</dimen>
    <dimen name="sp_3">12dp</dimen>
    <dimen name="sp_4">16dp</dimen>
    <dimen name="sp_5">20dp</dimen>
    <dimen name="sp_6">24dp</dimen>
    <dimen name="sp_8">32dp</dimen>
    <dimen name="sp_10">40dp</dimen>

    <!-- page gutter -->
    <dimen name="gutter">20dp</dimen>

    <!-- corner radii -->
    <dimen name="r_sm">12dp</dimen>
    <dimen name="r_md">18dp</dimen>
    <dimen name="r_lg">24dp</dimen>
    <dimen name="r_xl">30dp</dimen>
    <dimen name="r_pill">999dp</dimen>

    <!-- strokes -->
    <dimen name="hairline">1dp</dimen>

    <!-- type scale -->
    <dimen name="t_display">30sp</dimen>
    <dimen name="t_title">21sp</dimen>
    <dimen name="t_section">13sp</dimen>
    <dimen name="t_row">16sp</dimen>
    <dimen name="t_body">14.5sp</dimen>
    <dimen name="t_caption">12.5sp</dimen>

    <!-- components -->
    <dimen name="badge">44dp</dimen>
    <dimen name="badge_icon">22dp</dimen>
    <dimen name="row_min">64dp</dimen>
    <dimen name="topbar">60dp</dimen>
    <dimen name="elev_card">6dp</dimen>

</resources>
