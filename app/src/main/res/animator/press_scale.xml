<?xml version="1.0" encoding="utf-8"?>
<!-- Cards sink a little under the finger and spring back on release. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.965"
                android:duration="140" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.965"
                android:duration="140" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1"
                android:duration="260" android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1"
                android:duration="260" android:interpolator="@android:interpolator/overshoot" />
        </set>
    </item>
</selector>
