<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming screen: rises slightly and fades in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate android:fromYDelta="4%p" android:toYDelta="0" android:duration="260" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="200" />
    <scale android:fromXScale="0.98" android:toXScale="1"
        android:fromYScale="0.98" android:toYScale="1"
        android:pivotX="50%p" android:pivotY="50%p" android:duration="260" />
</set>
