<?xml version="1.0" encoding="utf-8"?>
<!-- New screen grows in from 92% while fading in (direction-neutral, so it
     reads the same in RTL and LTR). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="260" />
    <scale android:fromXScale="0.92" android:toXScale="1" android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="320" />
</set>
