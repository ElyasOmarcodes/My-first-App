<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="0.4" android:toAlpha="1" android:duration="280" />
    <scale android:fromXScale="1.05" android:toXScale="1" android:fromYScale="1.05" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="300" />
</set>
