<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming page (Material "fade through"): waits for the old page to
     clear, then fades in while growing from 96%. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="0" android:toAlpha="1"
        android:startOffset="70" android:duration="230" />
    <scale android:fromXScale="0.96" android:toXScale="1"
        android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="30%"
        android:startOffset="70" android:duration="260" />
</set>
