<?xml version="1.0" encoding="utf-8"?>
<!-- Outgoing screen under the new one: settles back a touch. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="1" android:toAlpha="0.4" android:duration="220" />
    <scale android:fromXScale="1" android:toXScale="0.97"
        android:fromYScale="1" android:toYScale="0.97"
        android:pivotX="50%p" android:pivotY="50%p" android:duration="220" />
</set>
