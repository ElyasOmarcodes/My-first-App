<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY. Exports the app's screens so the CI screenshot job
     can open each one directly with `adb shell am start -n`. Release builds
     never see this file, so their screens stay private. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name="com.elyas.multiling.MainActivity"
            android:exported="true" tools:replace="android:exported" />
        <activity android:name="com.elyas.multiling.SettingsActivity"
            android:exported="true" tools:replace="android:exported" />
        <activity android:name="com.elyas.multiling.PrivacyActivity"
            android:exported="true" tools:replace="android:exported" />
    </application>
</manifest>
